# Training code, jobs and data live in the separate private haodu-training repo.
# Prevent accidentally copying them back into the public repository.
/training/
# Website source and store materials live in the private haodu-release repo.
/site/
/release/
__pycache__/
*.pyc
/dist/
.DS_Store
/.claude/worktrees/

# Deployment credentials and private certificate material stay outside Git.
.env
.env.*
!.env.example
.ossutilconfig
*.key
*.pem
*.p12
*.pfx
*.keystore
/credentials/
/secrets/
