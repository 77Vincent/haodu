# Training code, jobs and data live in the separate private haodu-training repo.
# Prevent accidentally copying them back into the public repository.
/training/
# Website source and store materials live in the private haodu-release repo.
# Keep the public privacy policy at its original path for store listing links.
/site/*
!/site/content/
/site/content/*
!/site/content/privacy.md
/release/
__pycache__/
*.pyc
/dist/
/artifacts/
# The official BZNSYP corpus is installed locally, not redistributed with code.
/benchmark/golden/cases.csv
.DS_Store
/.claude/worktrees/

# Deployment credentials and private certificate material stay outside Git.
.env
.env.*
!.env.example
.ossutilconfig
*.key
*.pem
*.p12
*.pfx
*.keystore
/credentials/
/secrets/
