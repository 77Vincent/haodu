{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.4.0",
  "minimum_chrome_version": "113",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "homepage_url": "https://haodu.site/",
  "permissions": ["offscreen", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "好读",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/off-16.png",
      "32": "icons/off-32.png"
    }
  },
  "commands": {
    "haodu-toggle": {
      "suggested_key": { "default": "Alt+Shift+U" },
      "description": "开启或关闭阅读辅助"
    }
  },
  "background": {
    "service_worker": "src/platform/chrome/background.js"
  },
  "web_accessible_resources": [{
    "resources": ["src/content.css"],
    "matches": ["<all_urls>"]
  }]
}
