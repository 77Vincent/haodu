{
  "standard": "unicode-context-v20",
  "input_representation": "unicode-context-v1",
  "tokenization": "character",
  "proxy_punctuation": [
    "，",
    "。",
    "；",
    "！",
    "？",
    "…"
  ],
  "conditional_proxy_punctuation": [
    ",",
    ".",
    ";",
    "?",
    "!",
