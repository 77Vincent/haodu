      ],
      [
        "＇",
        "＇"
      ]
    ]
  },
  "wrapper_boundaries": {
    "pairs": [
      [
        "(",
        ")"
      ],
      [
        "（",
        "）"
      ],
      [
        "[",
        "]"
      ],
      [
