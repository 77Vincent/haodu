        "〉"
      ]
    ]
  },
  "protected_structures": {
    "patterns": {
      "decimal_version": "(?<!\\d)\\d+(?:\\.\\d+)+(?:[eE][+-]?\\d+)?",
      "leading_decimal": "\\.\\d+",
      "time_ratio": "(?<![\\d.])[+\\-−]?[ \\t]*(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][+\\-]?\\d+)?(?:[ \\t]*:[ \\t]*[+\\-−]?[ \\t]*(?:\\d+(?:\\.\\d+)?|\\.\\d+)(?:[eE][+\\-]?\\d+)?)+",
      "thousands": "(?<!\\d)\\d{1,3}(?:,\\d{3})+(?:\\.\\d+)?(?!\\d)",
      "url": "(?:https?|ftp)://[A-Za-z0-9\\[][A-Za-z0-9._~:/?#\\[\\]@!$&()*+,;=%-]*",
      "domain": "(?<![A-Za-z0-9_.-])(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+(?:[A-Za-z]{2,63}|xn--[A-Za-z0-9-]{2,59})(?![A-Za-z0-9_-])(?::\\d{1,5})?(?:[/?#][A-Za-z0-9._~:/?#\\[\\]@!$&()*+,;=%-]*)?",
      "list_number": "(?:^|(?<=[ \\t\\n\\r:;,!?()\\[\\].。；，！？…]))\\d{1,3}(?:\\.\\d{1,3})*\\.(?![\\d.])",
      "model_version": "(?<![A-Za-z0-9_])[A-Za-z][A-Za-z0-9_-]*\\.\\d+(?:\\.\\d+)*",
      "latin_marker": "(?<![A-Za-z0-9_])[A-Za-z]\\.(?=[ \\t])",
      "latin_abbreviation": "(?<![A-Za-z])(?:Mr|Mrs|Ms|Dr|Prof|Sr|Jr|St|etc|vs)\\.(?=[ \\t])",
      "nested_list_number": "(?<!\\d)\\d{1,3}(?:\\.\\d{1,3})+\\.(?=[ \\t])"
    }
  },
  "conditional_unit_neighbors": [
    "℃",
    "℉"
  ]
}
